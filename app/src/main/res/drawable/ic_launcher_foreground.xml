<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- logo de myciclo -->
    <!-- el anillo abierto es el ciclo y la gota del centro es la muestra de saliva de eva -->
    <!-- todo va dentro de los 72dp del centro, que es la zona segura del icono adaptativo:
         si el dibujo se sale de ahi el launcher lo recorta -->

    <!-- anillo del ciclo, abierto arriba, en el rosa claro de la paleta -->
    <!-- strokeLineCap redondo para que las puntas del corte no queden cuadradas -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFD8E4"
        android:strokeWidth="9"
        android:strokeLineCap="round"
        android:pathData="M68.9,32.7 A26,26 0 1 1 39.1,32.7" />

    <!-- gota al centro, blanca para que sea lo primero que se vea -->
    <!-- la punta queda arriba y la base es media circunferencia -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,41 C61,49 65,53 65,57 A11,11 0 1 1 43,57 C43,53 47,49 54,41 Z" />
</vector>
