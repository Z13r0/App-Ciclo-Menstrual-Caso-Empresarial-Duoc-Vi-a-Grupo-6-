# plantilla de las credenciales de firma del apk de release
#
# como usarla:
# 1. copiar este archivo como keystore.properties (sin el .ejemplo)
# 2. pedirle al grupo el archivo myciclo-release.jks y las claves
# 3. dejar el .jks en la raiz del proyecto, al lado de settings.gradle.kts
#
# keystore.properties y los .jks estan en .gitignore y no se suben nunca:
# el .jks es la llave con la que se firma la app y las claves la abren
#
# si falta este archivo el proyecto compila igual, pero el apk de release
# sale sin firmar (sirve para probar, no para entregar)

storeFile=myciclo-release.jks
storePassword=la-clave-del-keystore
keyAlias=myciclo
keyPassword=la-clave-de-la-llave
